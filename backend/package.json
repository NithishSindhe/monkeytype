{
  "name": "@monkeytype/backend",
  "version": "1.14.3",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "lint": "oxlint . --type-aware --type-check",
    "lint-fast": "oxlint .",
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "ts-check": "tsc --noEmit",
    "start": "node ./dist/server.js",
    "test": "vitest run --project=unit",
    "integration-test": "vitest run --project=integration",
    "test-coverage": "vitest run --coverage",
    "dev": "concurrently -p none \"tsx watch --clear-screen=false --inspect ./src/server.ts\" \"tsc --preserveWatchOutput --noEmit --watch\"  \"esw src/ -w --ext .ts --cache --color\"",
    "migrate": "node scripts/migrate.cjs"
  },
  "dependencies": {
    "@date-fns/utc": "1.2.0",
    "@monkeytype/challenges": "workspace:*",
    "@monkeytype/contracts": "workspace:*",
    "@monkeytype/funbox": "workspace:*",
    "@monkeytype/schemas": "workspace:*",
    "@monkeytype/util": "workspace:*",
    "@neondatabase/serverless": "1.1.0",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/express": "3.52.1",
    "chalk": "4.1.2",
    "cors": "2.8.6",
    "date-fns": "3.6.0",
    "dotenv": "17.4.2",
    "etag": "1.8.1",
    "express": "5.2.0",
    "express-rate-limit": "8.5.2",
    "firebase-admin": "12.0.0",
    "helmet": "4.6.0",
    "lru-cache": "11.5.1",
    "mongodb": "6.3.0",
    "object-hash": "3.0.0",
    "prom-client": "15.1.3",
    "rate-limiter-flexible": "5.0.3",
    "ua-parser-js": "0.7.33",
    "uuid": "14.0.1",
    "winston": "3.6.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@monkeytype/oxlint-config": "workspace:*",
    "@monkeytype/typescript-config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.9.1",
    "@types/object-hash": "3.0.6",
    "@types/readline-sync": "1.4.8",
    "@types/supertest": "6.0.3",
    "@types/ua-parser-js": "0.7.36",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.5",
    "concurrently": "8.2.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "readline-sync": "1.4.10",
    "supertest": "7.1.4",
    "testcontainers": "11.11.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "ws": "8.18.0",
    "yaml": "2.8.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
